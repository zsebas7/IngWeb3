{
	"info": {
		"_postman_id": "4d4d0f26-d093-469c-8345-f38ed93f6b0e",
		"name": "GasLogix (manual)",
		"description": "Un request por endpoint, con los valores escritos a mano para probar cada caso cambiándolos. Usar con el entorno \"GasLogix manual\". Hacer primero los login: el token del operador queda en token (es el que usa la colección por defecto), el del caudalímetro en tokenCaudalimetro y el del admin en tokenAdmin. Para probar con otro usuario, cambiar la variable en la pestaña Auth del request.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "0 · Login",
			"description": "Guarda el token de cada usuario en el entorno.",
			"item": [
				{
					"name": "Login operador",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.set(\"token\", pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{usuarioOperador}}\",\n  \"password\": \"{{passOperador}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{urlBase}}/api/v1/login",
							"host": [
								"{{urlBase}}"
							],
							"path": [
								"api",
								"v1",
								"login"
							]
						},
						"description": "Guarda el token en la variable token del entorno."
					},
					"response": []
				},
