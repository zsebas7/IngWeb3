# Copiar a .env (no se versiona) y ajustar si hace falta.
# Valores solo para desarrollo local.

DB_ROOT_PASSWORD=gaslogix_root
DB_USER=gaslogix
DB_PASS=gaslogix

# Puertos del host. Cambiarlos si ya están ocupados en tu máquina
# (por ejemplo, si tenés otro MySQL corriendo en el 3306).
DB_HOST_PORT=3306
BACKEND_HOST_PORT=8080
